:root {
}

.unity-progress-bar__background {
    background-color: rgba(0, 0, 0, 0.914);
}

.unity-progress-bar__title {
    display: none;
}

.unity-progress-bar {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}

.minimap {
    position: absolute;
    right: 24px;
    bottom: 24px;
    width: 200px;
    height: 200px;
    overflow: hidden;
    border-radius: 100px;
    border-width: 3px;
    border-color: rgb(255, 255, 255);
}

.minimap__image, .minimap__markers { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.minimap-icon { position: absolute; width: 12px; height: 12px; translate: -50% -50%; border-radius: 6px; }
.marker-zone { background-color: rgb(255, 200, 0); }
.marker-zone--done { background-color: rgb(120, 120, 120); }
.marker-player { background-color: rgb(80, 200, 255); }

.keychain {
    position: absolute;
    right: 24px;
    bottom: 24px;
    width: 150px;
    height: 125px;
}

.keychain__wire {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.keychain-circle {
    position: absolute;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    border-width: 2px;
    border-color: rgb(0, 0, 0);
    translate: -50% -50%; /* position by circle centre */
    transition-property: background-color, scale;
    transition-duration: 0.3s;
}

/* Circle centres, matching the wire loop in KeyChainView */
#keychain-circle-0 { left: 40%; top: 22%; }
#keychain-circle-1 { left: 19%; top: 78%; }
#keychain-circle-2 { left: 80%; top: 76%; }

/* Level states */
.keychain-circle--unplayed  { background-color: rgb(55, 55, 55); }
.keychain-circle--active    { background-color: rgb(212, 167, 44); scale: 1.12 1.12; }
.keychain-circle--completed { background-color: rgb(255, 255, 255); }
