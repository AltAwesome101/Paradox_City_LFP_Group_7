<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="arrow-image" src="project://database/Assets/UI%20Toolkit/UXML/arrow-image.uxml?fileID=9197481963319205126&amp;guid=05e58686ef7859545b861b2d2fbefb9c&amp;type=3#arrow-image"/>
    <Style src="project://database/Assets/UI%20Toolkit/USS/ForestLevelUSS.uss?fileID=7433441132597879392&amp;guid=c64a7d6bc0dcc7d409338f8a6ddf4063&amp;type=3#ForestLevelUSS"/>
    <ui:ProgressBar value="0" title="my-progress" name="wake-progressbar"/>
    <ui:VisualElement name="applenotifier-element-archor" style="flex-grow: 0; flex-shrink: 0; width: 1699px; height: 451px; position: absolute; top: 468px; left: 129px;">
        <ui:Instance template="arrow-image" name="arrow-image" style="display: none;"/>
    </ui:VisualElement>
    <ui:VisualElement name="approachingApple-counter-element" style="flex-grow: 0; flex-shrink: 0; height: 92px; width: 463px; flex-direction: row; background-color: rgba(0, 0, 0, 0.824); position: absolute; top: 40px; left: 1454px;">
        <ui:Label text="Apple approaching in:" name="approachingApple-title-label" style="-unity-font-style: bold; font-size: 30px; color: rgb(255, 255, 255); -unity-text-align: middle-left;"/>
        <ui:Label text="10" name="approachingApple-counter-label" style="-unity-font-style: bold; font-size: 40px; color: rgb(255, 255, 255); -unity-text-align: middle-right;"/>
    </ui:VisualElement>
    <ui:VisualElement name="TutorialPanel-container" style="flex-grow: 1; position: absolute; height: 64px; width: 568px; top: 54px; left: 12px; background-color: rgba(0, 0, 0, 0); display: flex; flex-shrink: 0;">
        <ui:Image name="tutorial-image" style="height: 388px; width: 686px; flex-shrink: 0; flex-grow: 1; position: absolute; top: 259px; left: 619px; background-color: rgb(0, 0, 0); border-top-width: 1.2px; border-right-width: 1.2px; border-bottom-width: 1.2px; border-left-width: 1.2px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);"/>
        <ui:VisualElement name="tutorial-instruction-container" style="flex-grow: 0; width: auto; flex-shrink: 0; background-color: rgba(0, 0, 0, 0.945); min-width: auto; align-self: flex-start; max-width: 1000px;">
            <ui:Label text="Label" name="tutorial-instruction-label" style="font-size: 25px; -unity-font-style: bold; color: rgb(255, 255, 255); bottom: auto; right: auto; top: auto; white-space: normal; width: 100%;"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="appleCollection-container" style="flex-grow: 0; flex-shrink: 0; height: 92px; width: 368px; flex-direction: row; background-color: rgba(0, 0, 0, 0.824); position: absolute; top: 978px; left: 11px;">
        <ui:Label text="0/10 Apples Caught" name="appleCollection-label" style="-unity-font-style: bold; font-size: 30px; color: rgb(255, 255, 255); -unity-text-align: middle-left; right: -33px;"/>
    </ui:VisualElement>
    <ui:VisualElement name="pauseMenu-container" style="flex-grow: 0; color: rgb(18, 17, 17); flex-shrink: 0; position: absolute; height: 788px; width: 1314px; top: 158px; left: 272px; background-color: rgb(0, 0, 0); display: flex; opacity: 1;">
        <ui:Label text="Pause Menu" name="pauseMenu-title" style="color: rgb(245, 245, 245); -unity-text-align: upper-center; font-size: 50px;"/>
        <ui:Label text="Apple Forest - 16th century" name="pauseMenu-Level-title" style="color: rgb(245, 245, 245); -unity-text-align: upper-center; font-size: 35px; top: 47px;"/>
        <ui:Button text="Resume" name="resume-button" style="width: 338px; height: 64px; top: 258px; position: absolute; left: 477px; -unity-font-style: bold; font-size: 25px;"/>
        <ui:Button text="Restart Level" name="restart-button" style="width: 338px; height: 64px; top: 392px; position: absolute; left: 476px; -unity-font-style: bold; font-size: 25px;"/>
        <ui:Button text="Return To Future" name="future-button" style="width: 338px; height: 64px; top: 545px; position: absolute; left: 480px; -unity-font-style: bold; font-size: 25px;"/>
    </ui:VisualElement>
    <ui:VisualElement name="interactPrompt-container" style="flex-grow: 0; position: absolute; height: 64px; width: 568px; top: 500px; left: 745px; background-color: rgba(0, 0, 0, 0); display: flex; color: rgb(27, 27, 27);">
        <ui:Label text="Label" name="interactPrompt-label" style="font-size: 33px; -unity-font-style: bold; color: rgb(253, 253, 253); bottom: 0; right: -18px; -unity-text-align: upper-center;"/>
    </ui:VisualElement>
    <ui:VisualElement name="objective-container" style="flex-grow: 0; flex-shrink: 0; height: auto; width: auto; flex-direction: row; background-color: rgba(0, 0, 0, 0.824); position: absolute; top: 1014px; left: 767px;">
        <ui:Label text="0/10 Apples Caught" name="objective-label" style="-unity-font-style: bold; font-size: 30px; color: rgb(255, 255, 255); -unity-text-align: middle-left; right: auto; align-self: flex-start;"/>
    </ui:VisualElement>
    <ui:VisualElement name="minimap-container" class="minimap" style="bottom: 37px; right: 1672px;">
        <ui:VisualElement name="minimap-image" class="minimap__image"/>
        <ui:VisualElement name="minimap-markers" picking-mode="Ignore" class="minimap__markers"/>
    </ui:VisualElement>
    <ui:VisualElement name="keychain-container" picking-mode="Ignore" class="keychain">
        <ui:VisualElement name="keychain-wire" picking-mode="Ignore" class="keychain__wire"/>
        <ui:VisualElement name="keychain-circle-0" picking-mode="Ignore" class="keychain-circle keychain-circle--unplayed"/>
        <ui:VisualElement name="keychain-circle-1" picking-mode="Ignore" class="keychain-circle keychain-circle--unplayed"/>
        <ui:VisualElement name="keychain-circle-2" picking-mode="Ignore" class="keychain-circle keychain-circle--unplayed"/>
    </ui:VisualElement>
</ui:UXML>
