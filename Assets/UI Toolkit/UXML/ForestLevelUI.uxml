    <ui:VisualElement name="objective-container" style="flex-grow: 1; flex-shrink: 1; height: auto; width: auto; flex-direction: row-reverse; background-color: rgba(0, 0, 0, 0); position: absolute; top: 7px; left: 10px; display: none;">
        <ui:Label text="Zones Completed" name="objective-label" style="-unity-font-style: bold; font-size: 35px; color: rgb(255, 255, 255); -unity-text-align: middle-left; right: auto; align-self: flex-start; margin-top: 2px; margin-right: 0; margin-bottom: 0; margin-left: -17px; padding-top: 6px; padding-right: 5px; padding-bottom: 0; padding-left: 37px; flex-shrink: 1; flex-grow: 1; background-color: rgba(16, 15, 15, 0.996);"/>
