    </ui:VisualElement>
    <ui:VisualElement name="appleCollection-container" style="flex-grow: 1; flex-shrink: 1; height: auto; width: auto; flex-direction: row; background-color: rgba(0, 0, 0, 0); position: absolute; top: 978px; left: 815px;">
        <ui:Label text="0/10 Apples Caught" name="appleCollection-label" style="-unity-font-style: bold; font-size: 30px; color: rgb(255, 255, 255); -unity-text-align: middle-left; right: auto; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; align-items: stretch; background-color: rgb(18, 15, 15); border-top-width: 1.2px; border-right-width: 1.2px; border-bottom-width: 1.2px; border-left-width: 1.2px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255);"/>
        <ui:VisualElement name="appleCollection-icon-container" style="flex-grow: 0; flex-shrink: 0; width: 60px; height: 60px; background-color: rgb(141, 182, 0); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255);">
