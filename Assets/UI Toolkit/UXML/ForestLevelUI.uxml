    <ui:VisualElement name="approachingApple-counter-container" style="flex-grow: 0; flex-shrink: 0; height: auto; width: auto; flex-direction: row-reverse; background-color: rgba(0, 0, 0, 0); position: absolute; top: 56px; left: 1454px; background-image: none; flex-wrap: nowrap; display: none;">
        <ui:VisualElement name="approachingApple-Label-container" style="flex-grow: 0; flex-direction: row; background-color: rgba(22, 19, 19, 0.98); flex-shrink: 0; align-items: auto; align-self: center; margin-top: -21px; margin-right: -21px; margin-bottom: -21px; margin-left: -21px; padding-top: 2px; padding-right: 8px; padding-bottom: 2px; padding-left: 40px;">
            <ui:Label text="Apple incoming in:" name="approachingApple-title-label" style="-unity-font-style: bold; font-size: 30px; color: rgb(255, 255, 255); -unity-text-align: middle-right; align-self: auto;"/>
            <ui:Label text="10" name="approachingApple-counter-label" style="-unity-font-style: bold; font-size: 40px; color: rgb(255, 255, 255); -unity-text-align: lower-right; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
        </ui:VisualElement>
        <ui:VisualElement name="approachingApple-icon-container" style="flex-grow: 0; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); background-color: rgba(141, 182, 0, 0.871); rotate: -45deg; width: 60px; flex-shrink: 0; height: 60px;">
