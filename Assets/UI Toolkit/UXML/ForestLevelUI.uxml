    <ui:VisualElement name="wake-container" style="flex-grow: 1; position: absolute; height: 5%; width: 80%; flex-direction: row-reverse; top: 18px; left: 98px; border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0);">
        <ui:ProgressBar value="100" title="my-progress" name="wake-progressbar" style="flex-grow: 1; border-left-color: rgba(255, 255, 255, 0); border-right-color: rgba(255, 255, 255, 0); border-top-color: rgba(255, 255, 255, 0); border-bottom-color: rgba(255, 255, 255, 0);"/>
        <ui:VisualElement name="wake-icon-container" style="flex-grow: 0; flex-shrink: 0; background-color: rgb(245, 245, 245); width: 40px; height: 40px; rotate: -45deg;">
            <ui:VisualElement name="wake-icon-outline" style="flex-grow: 1; flex-shrink: 0; border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-left-color: rgba(18, 17, 17, 0.933); border-right-color: rgba(18, 17, 17, 0.933); border-top-color: rgba(18, 17, 17, 0.933); border-bottom-color: rgba(18, 17, 17, 0.933); margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px;">
                <ui:Image name="wake-icon" source="project://database/Assets/SVG%20Icons/sleep-svgrepo-com.svg?fileID=7388822144124034973&amp;guid=6c3a076be490d2a479bfb1e9436ebdc9&amp;type=3#sleep-svgrepo-com" tint-color="rgb(230, 230, 230)" style="flex-shrink: 0; flex-grow: 1; rotate: 45deg;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
